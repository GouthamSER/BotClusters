# -------------------------------------------------------------
# BotClusters Environment Configuration (cluster.env)
# -------------------------------------------------------------

# Web Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Web Server Port (optional, default: 5000)
PORT=5000

# Ping Server Configuration (keep-alive for Render / Koyeb free tiers)
# APP_URL=https://your-botclusters-app.onrender.com
# PING_INTERVAL=240
# DELAY_PING=False

# Telegram Crash & Auto-Pause Alerts (optional)
# TELEGRAM_NOTIFY_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuvwxYZ
# TELEGRAM_NOTIFY_CHAT_ID=123456789

# Auto-update from upstream repo on startup (True / False)
AUTO_UPDATE=True
UPSTREAM_REPO=https://github.com/GouthamJosh/BotClusters
UPSTREAM_BRANCH=main

# -------------------------------------------------------------
# BOT CLUSTER CONFIGURATIONS
# Format: ["botname", "git_url", "branch", "run_command", {ENV_DICT}, "runtime_version", "cron"]
# - botname: Unique identifier for the bot (e.g. "bot01", "musicbot01")
# - git_url: Git clone URL (supports private tokens in URL)
# - branch: Git branch to clone (e.g. "main", "master")
# - run_command: Entry script to execute (e.g. "bot.py", "index.js", "npm start", "start.sh")
# - ENV_DICT (optional): JSON object of environment variables for this bot
# - runtime_version (optional): 
#     * Python: "3.10", "3.11", "3.12", "3.13"
#     * Node.js: "node:20", "node:22", "node:latest"
# - cron (optional): Auto-restart cron expression (e.g. "0 */6 * * *")
# -------------------------------------------------------------

# Example 1: Standard Python Telegram bot
# CLUSTER_01=["bot01", "https://github.com/exampleuser/telebot.git", "main", "bot.py", {"BOT_TOKEN": "123456:ABC-DEF", "PORT": "8080"}]

# Example 2: Node.js bot (Node 22 LTS / Latest, automatic npm install from package.json)
# CLUSTER_02=["nodebot01", "https://github.com/exampleuser/node-telegram-bot.git", "main", "index.js", {"BOT_TOKEN": "123456:ABC-DEF"}, "node:22"]

# Example 3: Node.js bot using Node 20 with npm start
# CLUSTER_03=["nodebot02", "https://github.com/exampleuser/discord-bot.git", "main", "npm start", {"DISCORD_TOKEN": "xyz789"}, "node:20"]

# Example 4: Python bot requiring Python 3.13 (Latest)
# CLUSTER_04=["pybot03", "https://github.com/exampleuser/latestbot.git", "main", "run.py", {"BOT_TOKEN": "789:XYZ"}, "3.13"]

# Example 5: Auto-restart every 6 hours (cron expression is the 7th item)
# CLUSTER_05=["bot05", "https://github.com/exampleuser/bot.git", "main", "bot.py", {"BOT_TOKEN": "1:ABC"}, "3.12", "0 */6 * * *"]
