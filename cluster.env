# -------------------------------------------------------------
# BotClusters Environment Configuration (cluster.env)
# -------------------------------------------------------------

# Web Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Web Server Port (default: 5000)
PORT=5000

# Ping Server Configuration (keep-alive for Render / Koyeb free tiers)
# APP_URL=https://your-botclusters-app.onrender.com
# PING_INTERVAL=240
# DELAY_PING=False

# Auto-update from upstream repo on startup (True / False)
AUTO_UPDATE=False
UPSTREAM_REPO=https://github.com/MysteryDemon/BotClusters
UPSTREAM_BRANCH=main

# -------------------------------------------------------------
# BOT CLUSTER CONFIGURATIONS
# Format: ["botname", "git_url", "branch", "run_command", {ENV_DICT}, "python_version"]
# -------------------------------------------------------------

# CLUSTER_01=["bot01", "https://github.com/mysterydemon/botcluster.git", "main", "bot.py", {"PORT": "8787"}]
# CLUSTER_02=["bot02", "git_url", "branch", "run_command", {"ENV_VAR": "value"}]
